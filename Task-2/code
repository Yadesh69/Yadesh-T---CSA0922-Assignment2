import java.util.*;

public class Q2 {

    static volatile long sink;

    static void measure(String label, Runnable action) {

        long start = System.nanoTime();

        action.run();

        System.out.printf(
            "%-30s %d ns%n",
            label,
            System.nanoTime() - start
        );
    }

    public static void main(String[] args) {

        int[] sizes = {1000, 10000, 50000};

        for (int n : sizes) {

            System.out.println("\nLIST SIZE = " + n);

            ArrayList<Integer> a = new ArrayList<>();
            LinkedList<Integer> l = new LinkedList<>();

            for (int i = 0; i < n; i++) {
                a.add(i);
                l.add(i);
            }

            measure("ArrayList add end", () -> {

                ArrayList<Integer> x = new ArrayList<>();

                for (int i = 0; i < n; i++)
                    x.add(i);
            });

            measure("LinkedList add end", () -> {

                LinkedList<Integer> x = new LinkedList<>();

                for (int i = 0; i < n; i++)
                    x.add(i);
            });

            measure("ArrayList insert front", () -> {

                ArrayList<Integer> x = new ArrayList<>(a);

                for (int i = 0; i < 100; i++)
                    x.add(0, -i);
            });

            measure("LinkedList insert front", () -> {

                LinkedList<Integer> x = new LinkedList<>(l);

                for (int i = 0; i < 100; i++)
                    x.add(0, -i);
            });

            measure("ArrayList middle insert", () -> {

                ArrayList<Integer> x = new ArrayList<>(a);

                for (int i = 0; i < 100; i++)
                    x.add(x.size() / 2, -i);
            });

            measure("LinkedList middle insert", () -> {

                LinkedList<Integer> x = new LinkedList<>(l);

                for (int i = 0; i < 100; i++)
                    x.add(x.size() / 2, -i);
            });

            measure("ArrayList get k", () -> {

                for (int i = 0; i < 10000; i++)
                    sink += a.get((i * 31) % n);
            });

            measure("LinkedList get k", () -> {

                for (int i = 0; i < 10000; i++)
                    sink += l.get((i * 31) % n);
            });

            measure("ArrayList iteration", () -> {

                for (int v : a)
                    sink += v;
            });

            measure("LinkedList iteration", () -> {

                for (int v : l)
                    sink += v;
            });

            measure("ArrayDeque operations", () -> {

                ArrayDeque<Integer> d = new ArrayDeque<>();

                for (int i = 0; i < n; i++)
                    d.addLast(i);

                for (int i = 0; i < n; i++)
                    d.removeFirst();
            });
        }
    }
}
